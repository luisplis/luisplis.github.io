							<span class="badge bg-dark">Yii</span>
							<span class="badge bg-dark">Slots</span>
							<span class="badge bg-black">Integraciones SQL/API</span>
							<span class="badge bg-dark">Slots</span>
							<span class="badge bg-black">Constructores CMS</span>
							<span class="badge bg-dark">Prensa Digital</span>
							<span class="badge bg-dark">Comercio Electrónico</span>
							<span class="badge bg-black">Wordpress/Woocommerce</span>
							<span class="badge bg-dark">Automatización & Pruebas</span>
							<span class="badge bg-dark">Mailer & Mailing</span>
							<span class="badge bg-dark">Pasarelas Bancarias</span>
							<span class="badge bg-dark">Generadores de PDF</span>
							<span class="badge bg-black">Google Workspace</span>
							<span class="badge bg-black">Google Developer Tools</span>
							<span class="badge bg-dark">Pruebas Unitarias</span>
