							<span class="badge bg-primary">JavaScript (TS)</span>
							<span class="badge bg-dark">Metodologías Agile</span>
							<span class="badge bg-dark">CI/CD</span>
							<span class="badge bg-dark">IDE Antigravity IA</span>
							<span class="badge bg-dark">React</span>
							<span class="badge bg-dark">Angular</span>
							<span class="badge bg-dark">Node/Express</span>
							<span class="badge bg-dark">Astro</span>
							<span class="badge bg-dark">Lit Element</span>
							<span class="badge bg-dark">Git/​GitHub</span>
							<span class="badge bg-dark">GoogleCharts</span>
							<span class="badge bg-dark">​HighCharts</span>
