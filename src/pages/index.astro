---
import Main from '@layouts/Main.astro';
import Image from '@components/Image.astro';
import Card from '@components/Card.astro';
import Carousel from "@components/Carousel.astro";
import ViewPort from "@components/ViewPort.astro";
import Anime from '@components/Anime.astro';
import Cover from '@components/Cover.astro';
import Brands from '@components/Brands.astro';
import conf from '@conf';
export const name = 'Desarrollador Web';
export const term = 'Disponible Desarrollador Web';
export const desc = 'Técnico experto en desarrollo de aplicaciones y proyectos web desde el análisis y el diseño hasta la puesta en marcha';
export const menu = 0;
export const snap = '/web/github.png';
export const cv   = 'https://drive.google.com/file/d/1_BmoxWkJYV00g3rayRHySa_ZLOWBFZpm/view?usp=sharing';
---
<Main class="main bg-primary bg-opacity-25" title={name+': '+term} description={desc}>
	<Cover src="/background.svg">
		<div class="container py-4">
			<div class="row">
				<div class="col-12 col-md-6">
					<h1 class="h2 title text-dark">
						Desarrollador Web
					</h1>
					<p class="lead display text-primary text-nowrap">
						<strong>Experto en proyectos y aplicaciones</strong>
					</p>
					<div class="d-flex flex-column">
						<Card class="bg-white bg-opacity-85 mb-2 px-3 pb-2">
							<h2 class="h3 fw-normal text-black">
								Luis Martín Lázaro
							</h2>
							<ul class="small display lh-lg">
								<li>
									<strong class="title">DESARROLLADOR WEB FRONTEND</strong>
									<p class="small mt-n1 mb-2">
										<u>3 años</u> en BEWSAM INVERSA SL realizando proyectos para banca y financieras.
									</p>
								</li>
								<li>
									<strong class="title">DESARROLLADOR WEB FULLSTACK</strong>
									<p class="small mt-n1 mb-0">
										<u>12 años</u> en MASWEB CB creando infraestructura y aplicaciones web para negocios.
									</p>
								</li>
								<li class="list-unstyled mt-2">
									<p class="text-end mb-n1">
										<a class="btn btn-outline-secondary btn-sm" title="Luis Martín - CV Online" href={cv} target="_blank">
											CV Online
										</a>
									</p>
								</li>
							</ul>
						</Card>
						<div class="d-block my-1">
							<div class="-center">
								<span class="badge bg-dark px-2 my-n1 py-1 me-1">
									Experto en Aplicaciones Web de Negocios
								</span>
								<span class="link me-1">&raquo;</span>
								<span class="sonar badge bg-primary px-2 my-n1 py-1">
									WEB DEVELOPER FRONTEND
								</span>
							</div>
						</div>
					</div>
				</div>
				<div class="col-12 col-md-4 offset-md-1">
					<Anime animate="backInUp">
						<div class="py-3 ps-md-2 text-center">
							<Image class="img-fluid" src="/react-code.gif" width="350" height="350"/>
						</div>
					</Anime>
				</div>
			</div>
		</div>
		<div class="d-flex flex-column justify-content-center align-items-center">
			<div class="position-absolute" style="z-index: 1000;">
				<a class="link icon-link icon-link-hover-down fs-1" href="#trabajo" title="Desarrollador Web Frontend">
					<span class="bi bi-arrow-down-circle-fill bg-light rounded-circle"></span>
				</a>
			</div>
		</div>

		<section id="trabajo" class="bg-white">
			<article class="container py-4">
				<div class="row align-items-end">
					<div class="col-12 col-md-5 col-lg-4 order-last order-lg-first">
						<Anime animate="slideInLeft">
							<Image src="/misc/karl-pawlowicz-gbRaa67fEPo.jpg"/>
						</Anime>
					</div>
					<div class="col-12 col-md-7 col-lg-8 order-first order-lg-last">
						<h1 class="h2 mb-3">
							Trayectoria y futuro
						</h1>
						<p class="lead mb-3">
							Mis últimos 3 años los he dedicado como desarrollador web frontend en BEWSAM INVERSA SL como freelance, trabajando con varios frameworks y librerías de TypeScript y JavaScript como React, Angular y Astro (últimas versiones), siguiendo principios SOLID en proyectos web completamente a medida, usando Bootstrap para apps “pixel-perfect” y Taildwind para demos, generalmente en soluciones de banca para Web Financial Group (allfunds.com) manejando datos API en tiempo real.
						</p>
						<p class="mt-3">
							SO Linux, IDE VSCode, Git, programación reactiva (react/typescript), diseño Figma, Inkscape y Gimp, maquetanción SCSS/Bootstrap y TaildwindJS, entornos Git/Apache/Docker, Google API y Firebase, librerías GoogleCharts y HighCharts (tuplas/grafos), pruebas, patrones de diseño y principios SOLID.
						</p>
						<Anime animate="slideInRight" delay="0.15">
							<blockquote class="m-3 w-md-90 w-lg-65 br-md">
								Busco empleo como <strong>desarrollador web frontend</strong>, aunque mi experiencia también se remonta a <strong>gestor</strong>, <strong>analista</strong>, <strong>diseñador</strong> y <strong>programador</strong> en proyectos y aplicaciones realizadas desde el backend.
							</blockquote>
						</Anime>
						</div>
					</div>
				</div>
			</article>
		</section>

		<section id="experiencia" class="bg-light">
			<article class="container py-4">
				<div class="row align-items-end">
					<div class="col-12 col-md-7 col-lg-8">
						<h1 class="h2 mb-3">
							Origen y crecimiento
						</h1>
						<p class="lead">
							Trabajé durante más de 12 años como desarrollador web fullstack siendo autónomo y socio en MASWEB CB desarrollando páginas y aplicaciones web (decenas de proyectos) con varios frameworks de PHP y usando Git (hooks), SQL, NoSQL, XHTML, JS, JSON, SCSS, gestores de contenido (Grupo Vocento) y soluciones digitales (portalapardos.es, crear y mantener páginas web de clientes y crear la infraestructura y tecnológica de la empresa masweb.es de la cual me siento orgulloso.
						</p>
						<p class="mt-3">
							PHP Frameworks, Integraciones SQL/API, constructores web, CMS a medida y otros Wordpress/Woo, automatización y pruebas unitarias, mailer y mailing, pasarelas bancarias, generadores de pdf, infraestructura de negocio con Workspace, Pagespeed, Looker Studio, Adwords y Analytics.
						</p>
						<Anime animate="slideInLeft" delay="0.15">
							<blockquote class="m-3 bg-white w-md-90 w-lg-65 br-md">
								Quiero nuevos <strong>retos profesionales</strong> que me permitan <strong>trabajar en remoto</strong> como diseñador, analista de datos y programador de aplicaciones web punteras e innovadoras.
							</blockquote>
						</Anime>
					</div>
					<div class="col-12 col-md-5 col-lg-4">
						<Anime animate="slideInRight">
							<Image src="/misc/karl-pawlowicz-QUHuwyNgSA0.jpg"/>
						</Anime>
					</div>
				</div>
			</article>
		</section>

		<section id="proyectos" class="bg-white">
			<article class="container py-4">
				<div class="row align-items-end">
					<div class="col-12 col-md-5 col-lg-4 order-last order-lg-first">
						<Anime animate="slideInLeft">
							<Image src="/misc/morgan-richardson-ONJM0-j6XM4.jpg"/>
						</Anime>
					</div>
					<div class="col-12 col-md-7 col-lg-8 order-first order-lg-last">
						<h1 class="h2 mb-3">
							Aptitudes y espectativas
						</h1>
						<p class="lead mb-3">
							Gracias a mi experiencia, conozco y domino diferentes lenguajes de programación web. Además, estoy muy acostumbrado a investigar y usar tecnologías punteras, frameworks, componentes y librerías, siempre aportando soluciones óptimas e innovadoras en mis proyectos.
						</p>
						<p class="mt-3">
							En el trabajo, dispongo de una gran capacidad de aprendizaje debido al sector tan evolutivo en el que me desenvuelvo. Estoy habituado a trabajar en equipo y no me asustan los retos ni las situaciones de estrés, además, me preocupo bastante por la estandarización y la calidad del trabajo final.
						</p>
						<Anime animate="slideInRight" delay="0.1">
						<blockquote class="m-3 w-md-90 w-lg-65 br-md">
							En definitiva, <strong>busco un trabajo donde pueda expresarme</strong> 
							<br/>e implicarme personal y profesionalmente para tener una vida plena en mi futuro, haciendo lo que me gusta.
						</blockquote>
						</Anime>
					</div>
				</div>
			</article>
			<div class="d-flex flex-column justify-content-center align-items-center">
				<div class="position-absolute" style="z-index: 1000;">
					<a class="link icon-link icon-link-hover-down fs-1" href="#tecnologia" title="Desarrollador Web Frontend">
						<span class="bi bi-arrow-down-circle-fill bg-light rounded-circle"></span>
					</a>
				</div>
			</div>
		</section>

		<div id="tecnologia" class="">
			<Brands path="/web/" format="png" gap="30" speed="23" width="100" height="100" style="rounded bg-white bg-opacity-85 shadow" />
		</div>

		<section class="bg-white py-3">
			<article class="container">
				<div class="row">
					<div class="col-12 col-md-4 p-3">
						<div class="position-relative text-center">
							<h2 class="h2 text-uppercase stretched-hover">
								Experiencia
							</h2>
							<span class="bi bi-cloud text-primary display-1"></span>
							<p class="border p-2 bg-light rounded mb-3 stretched-layer">
								He trabajado como autónomo durante más de <strong>15 años</strong>, incluso en mi propia empresa, 
								he tenido que prosperar en <strong>entornos de trabajo</strong> muy competitivos con tecnologías punteras.
							</p>
							<div class="text-center">
								<a class="btn btn-outline-primary stretched-link ms-md-n1 me-md-3" href={conf.base+'/experiencia'} title="CV - Experiencia Profesional">
									<span class="bi bi-file-earmark-zip-fill"></span> Trayectoria Profesional
								</a>
							</div>
						</div>
					</div>
					<div class="col-12 col-md-4 p-3">
						<div class="position-relative text-center">
							<h2 class="h2 text-uppercase stretched-hover">
								Pericia
							</h2>
							<span class="bi bi-activity text-primary display-1"></span>
							<p class="border p-2 bg-light rounded mb-3 stretched-layer">
								La tarea que más he realizado es el <strong>ciclo de vida completo</strong> de proyectos web, 
								desde su planteamiento y presupuesto hasta hasta su puesta en marcha y crecimiento.
							</p>
							<div class="text-center">
								<a class="btn btn-outline-primary stretched-link ms-md-n1 me-md-3" href={conf.base+'/proyectos'} title="CV - Proyectos Destacados">
									<span class="bi bi-file-earmark-code-fill"></span> Proyectos Destacados
								</a>
							</div>
						</div>
					</div>
					<div class="col-12 col-md-4 p-3">
						<div class="position-relative text-center">
							<h2 class="h2 text-uppercase stretched-hover">
								Formación
							</h2>
							<span class="bi bi-cursor text-primary display-1"></span>
							<p class="border p-2 bg-light rounded mb-3 stretched-layer">
								Mi formación profesional ha crecido en paralelo a mis preferencias, siempre buscando la <strong>innovación</strong> y la <strong>automatización</strong>
								de diseño, desarrollo y puesta en marcha de <strong>aplicaciones web</strong>.
							</p>
							<div class="text-center">
								<a class="btn btn-outline-primary stretched-link ms-md-n1 me-md-3" href={conf.base+'/formacion'} title="CV - Formación Académica">
									<span class="bi bi-file-earmark-medical-fill"></span> Formación Académica
								</a>
							</div>
						</div>
					</div>
				</div>
			</article>
		</section>

		<section class="bg-light">
			<article class="container">
				<div class="row">
					<div class="col-12 col-md-7 mt-3">
						<p class="lead text-center lh-lg mb-0 mb-md-3">
							Si buscas un <strong>desarrollador web</strong>, no dudes en contactarme: 
						</p>
					</div>
					<div class="col-12 col-md-5 mt-3">
						<p class="text-center text-md-start lh-lg mt-n3 mt-md-n2">
							<a class="display link" href="tel:626918451" title="Luis Martín - aplicaciones web">
								<span class="bi bi-telephone-outbound-fill"></span>
								626 018 451
							</a>
							<br/>
							<a class="display link" href="mailto:luisplis@gmail.com" title="Luis Martín - desarrollador web">
								<span class="bi bi-send-fill"></span>
								luisplis@gmail.com
							</a>
						</p>
					</div>
				</div>
			</article>
		</section>
	</Cover>
</Main>
