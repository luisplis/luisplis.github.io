---
import Main from '@layouts/Main.astro';
import Image from '@components/Image.astro';
import Card from '@components/Card.astro';
import Carousel from "@components/Carousel.astro";
import ViewPort from "@components/ViewPort.astro";
import Anime from '@components/Anime.astro';
import Cover from '@components/Cover.astro';
import Brands from '@components/Brands.astro';
import conf from '@conf';
export const name = 'DISPONIBLE';
export const term = 'Desarrollador Web Fullstack JS/TS';
export const desc = 'Técnico experto en desarrollo de aplicaciones y proyectos web desde el análisis y el diseño hasta la puesta en marcha';
export const menu = 0;
export const snap = '/web/github.png';
export const cv = 'https://drive.google.com/file/d/1wyuRipb3wuPDYmJ956GARHKWPsExKgJP/view?usp=sharing';
---
<Main class="main bg-primary bg-opacity-25" title={term+' -- '+name} description={desc}>
	<Cover src="/background.svg">
		<div class="container py-4">
			<div class="row">
				<div class="col-12 col-md-6">
					<div class="d-flex flex-column">
						<Card class="bg-white bg-opacity-85 mb-2 px-3 pb-2">
							<h1 class="h2 text-center fw-lighter py-2">
								Luis Martín Lázaro
							</h1>
							<ul class="small display lh-lg">
								<li class="text-primary">
									<h2 class="h4 text-primary">
										<strong>Desarrollador Web Fullstack</strong>
									</h2>
									<p class="small mt-n1 mb-2 text-body">
										<u>4 años</u> generando proyectos llave en mano para banca y financieras, integrando microservicios y creando soluciones innovadoras y escalables para diferentes clientes.
									</p>
								</li>
								<li>
									<h2 class="h4 text-black">
										<strong>Experto en proyectos y aplicaciones web</strong>
									</h2>
									<p class="small mt-n1 mb-0">
										<u>12 años</u> creando infraestructura y aplicaciones web para negocios, he trabajado en mi propia empresa aportando valor al producto final, optimizando aplicaciones web, mejorando la accesibilidad, el posicionamiento y la experiencia de usuario.
									</p>
								</li>
							</ul>
							<div class="d-flex flex-row mb-3 mx-2">    
								<p class="mb-0 alert alert-info text-black flex-fill text-center">
									Portfolio exclusivamente profesional para <u>encontrar empleo</u>.
								</p>
								<a class="m-1 py-2 btn btn-outline-primary btn-sm flex-fill d-flex align-items-center justify-content-center border-2" title="Luis Martín - CV Online" href={cv} target="_blank">
									<span class="bi bi-file-pdf me-2"></span> <strong>C V</strong>
								</a>
							</div>
						</Card>
					</div>
				</div>
				<div class="col-12 col-md-4 offset-md-1">
					<Anime animate="backInUp">
						<div class="py-3 ps-md-2 text-center">
							<Image class="img-fluid" src="/react-code.gif" width="350" height="350"/>
						</div>
					</Anime>
				</div>
			</div>
		</div>
		<div class="d-flex flex-column justify-content-center align-items-center">
			<div class="position-absolute" style="z-index: 1000;">
				<a class="link icon-link icon-link-hover-down fs-1" href="#trabajo" title="Desarrollador Web Frontend">
					<span class="bi bi-arrow-down-circle-fill bg-light rounded-circle"></span>
				</a>
			</div>
		</div>

		<section id="trabajo" class="bg-white">
			<article class="container py-4">
				<div class="row align-items-end">
					<div class="col-12 col-md-5 col-lg-4 order-last order-lg-first">
						<Anime animate="slideInLeft">
							<Image src="/misc/karl-pawlowicz-gbRaa67fEPo.jpg"/>
						</Anime>
					</div>
					<div class="col-12 col-md-7 col-lg-8 order-first order-lg-last">
						<h1 class="h2 mb-3">
							Trayectoria y futuro
						</h1>
						<p class="lead mb-3">
							Desarrollo Web Frontend y Backend: últimos 4 años como desarrollador independiente (autónomo) en proyectos llave en mano, apps y microservicios para banca y financieras: gráficas, dashboards, storybooks, integraciones API, formularios, mailer, etc.
						</p>
						<p class="mt-3 small">
							<span class="badge bg-black">IA</span>
							<span class="badge bg-dark">Agile</span>
							<span class="badge bg-dark">UI/UX</span>
							<span class="badge bg-custom text-black">JavaScript</span>
							<span class="badge bg-dark">Node</span>
							<span class="badge bg-primary">Express</span>
							<span class="badge bg-dark">MongoDB</span>
							<span class="badge bg-primary">React</span>
							<span class="badge bg-primary">Angular</span>
							<span class="badge bg-primary">Lit</span>
							<span class="badge bg-dark">TypeScript</span>
							<span class="badge bg-dark">Bootstrap</span>
							<span class="badge bg-dark">Taildwind</span>
							<span class="badge bg-primary">Vitest</span>
							<span class="badge bg-primary">Docker</span>
							<span class="badge bg-dark">Github</span>
						</p>
						<p class="mb-3">
							He trabajado con varios frameworks y librerías de TypeScript y JavaScript como React/Express, Angular y Astro (últimas versiones), siguiendo principios SOLID en proyectos web basados en componentes completamente a medida, usando SCSS con Bootstrap y Taildwind JS para UI/UX,
							siempre manejando datos en tiempo real y metodología de entregas e integración continua con GitHub.
						</p>
						<Anime animate="slideInRight" delay="0.15">
							<blockquote class="m-3 w-md-90 w-lg-65 br-md">
								Busco trabajo como <strong>desarrollador web</strong> en remoto o híbrido, 
								donde pueda expresarme e implicarme personal y profesionalmente 
								para tener una vida plena haciendo lo que más me gusta.
							</blockquote>
						</Anime>
						</div>
					</div>
				</div>
			</article>
		</section>

		<section id="experiencia" class="bg-light">
			<article class="container py-4">
				<div class="row align-items-end">
					<div class="col-12 col-md-7 col-lg-8">
						<h1 class="h2 mb-3">
							Origen y crecimiento
						</h1>
						<p class="lead">
							He trabajado durante más de 16 años como desarrollador web, siendo fundador y socio de <strong>MASWEB CB</strong> y <strong>BEWSAM INVERSA SL</strong>, empresas dedicadas a proyectos web, 
							desarrollando páginas y aplicaciones web en decenas de proyectos con varios frameworks de backend y frontend.
							Además he liderado proyectos, soluciones digitales y aplicaciones llave en mano para clientes muy diversos
							como Web Financial Group, Repsol, Vector Software, Grupo Vocento, etc.
						</p>
						<p class="mt-3 small">
							<span class="badge bg-primary">SOLID</span>
							<span class="badge bg-black">CMS</span>
							<span class="badge bg-custom text-black">PHP</span>
							<span class="badge bg-dark">PHP Slots</span>
							<span class="badge bg-primary">Symfony</span>
							<span class="badge bg-primary">Yii</span>
							<span class="badge bg-dark">MySQL</span>
							<span class="badge bg-secondary">jQuery</span>
							<span class="badge bg-primary">HTML</span>
							<span class="badge bg-primary">CSS</span>
							<span class="badge bg-primary">JS</span>
							<span class="badge bg-dark">GoogleCharts</span>
							<span class="badge bg-dark">HighCharts</span>
							<span class="badge bg-black">Linux</span>
							<span class="badge bg-secondary">Apache</span>
							<span class="badge bg-dark">Git Hooks</span>
						</p>
						<p class="mt-3">
							Me siento orgulloso de haber podido crear gran parte de la infraestructura y tecnología de la empresa como un framework a medida que
							ha sido el núcleo y motor competitivo de la empresa durante muchos años.
						</p>
						<Anime animate="slideInLeft" delay="0.15">
							<blockquote class="m-3 bg-white w-md-90 w-lg-65 br-md">
								Siempre he trabajado en proyectos útiles, orientados al negocio o al producto final,
								donde puedo seguir aprendiendo <strong>nuevas tecnologías</strong> y aportar valor con <strong>soluciones creativas</strong>.
							</blockquote>
						</Anime>
					</div>
					<div class="col-12 col-md-5 col-lg-4">
						<Anime animate="slideInRight">
							<Image src="/misc/karl-pawlowicz-QUHuwyNgSA0.jpg"/>
						</Anime>
					</div>
				</div>
			</article>
		</section>

		<section id="proyectos" class="bg-white">
			<article class="container py-4">
				<div class="row align-items-end">
					<div class="col-12 col-md-5 col-lg-4 order-last order-lg-first">
						<Anime animate="slideInLeft">
							<Image src="/misc/morgan-richardson-ONJM0-j6XM4.jpg"/>
						</Anime>
					</div>
					<div class="col-12 col-md-7 col-lg-8 order-first order-lg-last">
						<h1 class="h2 mb-3">
							Aptitudes y espectativas
						</h1>
						<p class="lead mb-3">
							Gracias a mi experiencia, conozco y domino diferentes lenguajes de programación web. Además, estoy muy acostumbrado a investigar y usar tecnologías punteras, frameworks, componentes y librerías, siempre aportando soluciones óptimas e innovadoras en mis proyectos.
						</p>
						<p class="mt-3 small">
							<span class="badge bg-custom text-black">Linux</span>
							<span class="badge bg-dark">DevOps</span>
							<span class="badge bg-dark">Figma</span>
							<span class="badge bg-primary">Gimp</span>
							<span class="badge bg-primary">Inkscape</span>
							<span class="badge bg-secondary">IA</span>
							<span class="badge bg-dark">Google Developer Tools</span>
							<span class="badge bg-primary">Web Components</span>
							<span class="badge bg-dark">Landing Pages</span>
							<span class="badge bg-primary">Vite</span>
							<span class="badge bg-dark">Testing</span>
							<span class="badge bg-dark">OpenSource</span>
						</p>
						<p class="mt-3">
							En el trabajo, soy muy seguro y determinado, dispongo de una gran capacidad de aprendizaje debido al sector tan evolutivo en el que me desenvuelvo. Estoy habituado a trabajar con diferentes equipos y no me asustan los retos ni las situaciones de estrés, además, me preocupo bastante por la estandarización y la calidad del trabajo final.
						</p>
						<Anime animate="slideInRight" delay="0.1">
						<blockquote class="m-3 w-md-90 w-lg-65 br-md">
							Mi mayor cualidad, además de la <strong>experiencia</strong> es mi <strong>curiosidad innata</strong>,
							personal y profesionalmente, ambas, me aportan una mentalidad muy <strong>adaptativa</strong> y <strong>resolutiva</strong>. 
						</blockquote>
						</Anime>
					</div>
				</div>
			</article>
			<div class="d-flex flex-column justify-content-center align-items-center">
				<div class="position-absolute" style="z-index: 1000;">
					<a class="link icon-link icon-link-hover-down fs-1" href="#tecnologia" title="Desarrollador Web Frontend">
						<span class="bi bi-arrow-down-circle-fill bg-light rounded-circle"></span>
					</a>
				</div>
			</div>
		</section>

		<div id="tecnologia" class="">
			<Brands path="/web/" format="png" gap="30" speed="23" width="100" height="100" style="rounded bg-white bg-opacity-85 shadow" />
		</div>

		<section class="bg-white py-3">
			<article class="container">
				<div class="row">
					<div class="col-12 col-md-4 p-3">
						<div class="position-relative text-center">
							<h2 class="h2 text-uppercase stretched-hover">
								Experiencia
							</h2>
							<span class="bi bi-cloud text-primary display-1"></span>
							<p class="border p-2 bg-light rounded mb-3 stretched-layer">
								He trabajado como autónomo durante <strong>16 años</strong> en mi propia empresa, 
								adaptándome a diversos equipos y proyectos, 
								por lo que he tenido que prosperar en <strong>entornos de trabajo</strong> muy competitivos.
							</p>
							<div class="text-center">
								<a class="btn btn-outline-primary stretched-link ms-md-n1 me-md-3" href={conf.base+'/experiencia'} title="CV - Experiencia Profesional">
									<span class="bi bi-file-earmark-zip-fill"></span> Trayectoria Profesional
								</a>
							</div>
						</div>
					</div>
					<div class="col-12 col-md-4 p-3">
						<div class="position-relative text-center">
							<h2 class="h2 text-uppercase stretched-hover">
								Pericia
							</h2>
							<span class="bi bi-activity text-primary display-1"></span>
							<p class="border p-2 bg-light rounded mb-3 stretched-layer">
								He trabajado el <strong>ciclo de vida completo</strong> de proyectos y soluciones empresariales, 
								desde su estimación y presupuesto hasta su diseño, desarrollo y puesta en marcha en <strong>cliente</strong>.
							</p>
							<div class="text-center">
								<a class="btn btn-outline-primary stretched-link ms-md-n1 me-md-3" href={conf.base+'/proyectos'} title="CV - Proyectos Destacados">
									<span class="bi bi-file-earmark-code-fill"></span> Proyectos Destacados
								</a>
							</div>
						</div>
					</div>
					<div class="col-12 col-md-4 p-3">
						<div class="position-relative text-center">
							<h2 class="h2 text-uppercase stretched-hover">
								Formación
							</h2>
							<span class="bi bi-cursor text-primary display-1"></span>
							<p class="border p-2 bg-light rounded mb-3 stretched-layer">
								Mi formación profesional ha crecido en paralelo a mis preferencias, 
								siempre buscando la <strong>innovación</strong> y la <strong>optimización</strong>
								de diseño, desarrollo y puesta en marcha de <strong>aplicaciones web</strong>.
							</p>
							<div class="text-center">
								<a class="btn btn-outline-primary stretched-link ms-md-n1 me-md-3" href={conf.base+'/formacion'} title="CV - Formación Académica">
									<span class="bi bi-file-earmark-medical-fill"></span> Formación Académica
								</a>
							</div>
						</div>
					</div>
				</div>
			</article>
		</section>

		<section class="bg-light">
			<article class="container">
				<div class="row">
					<div class="col-12 col-md-7 mt-3">
						<p class="lead text-center lh-lg mb-0 mb-md-3">
							Si buscas un <strong>desarrollador web</strong>, no dudes en contactarme: 
						</p>
					</div>
					<div class="col-12 col-md-5 mt-3">
						<p class="text-center text-md-start lh-lg mt-n3 mt-md-n2">
							<a class="display link" href="tel:626918451" title="Luis Martín - aplicaciones web">
								<span class="bi bi-telephone-outbound-fill"></span>
								626 018 451
							</a>
							<br/>
							<a class="display link" href="mailto:luisplis@gmail.com" title="Luis Martín - desarrollador web">
								<span class="bi bi-send-fill"></span>
								luisplis@gmail.com
							</a>
						</p>
					</div>
				</div>
			</article>
		</section>
	</Cover>
</Main>
